<launch>
  <!-- Start the RoboSense driver. show_rviz defaults to true so existing
       callers behave unchanged; hardware.launch shuts it off because it also
       brings up arm_rviz (only one RViz window at a time). -->
  <arg name="show_rviz" default="true" />

  <node pkg="rslidar_sdk" name="rslidar_sdk_node" type="rslidar_sdk_node" output="screen">
    <param name="config_path" value=""/>
  </node>
  <!-- rviz -->
  <node if="$(arg show_rviz)" pkg="rviz" name="rviz" type="rviz" args="-d $(find rslidar_sdk)/rviz/rviz.rviz" />
</launch>
