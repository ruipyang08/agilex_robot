void MarkListenner::initial(geometry_msgs::PoseStamped msg[])
{
  for (int i = 0; i < 5; i++)
  {
    Clear(&msg[i]);
  }
}

void MarkListenner::initial(geometry_msgs::Pose msg[])
{
  for (int i = 0; i < 5; i++)
  {
    Clear(&msg[i]);
  }
}

void MarkListenner::SetPose(geometry_msgs::Pose msg)
{
  tf::Quaternion q;
  q.setRPY(1.57, 0, 0);
  msg.orientation.x = q.getX();
  msg.orientation.y = q.getY();
  msg.orientation.z = q.getZ();
  msg.orientation.w = q.getW();
}

void MarkListenner::Clear(geometry_msgs::PoseStamped *msg)
{

  msg->pose.position.x = 0;
  msg->pose.position.y = 0;
  msg->pose.position.z = 0;
  msg->header.seq = 0;
}

void MarkListenner::Clear(geometry_msgs::Pose *msg)
{
  msg->position.x = 0;
  msg->position.y = 0;
  msg->position.z = 0;
}

void MarkListenner::ClearMarkState()
{
  for (int i = 0; i < sizeof(Item); i++)
  {
    is_mark_empty[i] = true;
  }
}

bool MarkListenner::getTransform(const std::string &parentFrame, const std::string &childFrame, agx_pick_msg::AgxPickSrv::Response &res)
{
  std::string errMsg;

  if (!tfListener_.waitForTransform(parentFrame, childFrame, ros::Time::now(), ros::Duration(0.5), ros::Duration(0.01),
                                    &errMsg))
  {
    ROS_ERROR_STREAM("Unable to get pose from TF: " << errMsg);
    return false;
  }
  else
  {
    tf::StampedTransform transform;
    try
    {
      tfListener_.lookupTransform(parentFrame, childFrame, ros::Time::now(), transform);
      res.position.x = transform.getOrigin().x();
      res.position.y = transform.getOrigin().y();
      res.position.z = transform.getOrigin().z();
      res.orientation.x = transform.getRotation().getX();
      res.orientation.y = transform.getRotation().getY();
      res.orientation.z = transform.getRotation().getZ();
      res.orientation.w = transform.getRotation().getW();
    }
    catch (const tf::TransformException &e)
    {
      ROS_ERROR_STREAM("Error in lookupTransform of " << childFrame << " in " << parentFrame);
      return false;
    }
  }
  return true;
}