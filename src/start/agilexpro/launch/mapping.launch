<?xml version="1.0"?>
<launch>
  <arg name="show_rviz" default="true" />

  <node pkg="gmapping"
        type="slam_gmapping"
        name="simple_gmapping"
        output="screen">
    <rosparam>
      odom_frame: odom
      base_frame: dummy_base_link
      map_frame: map

      map_update_interval: 0.5
      maxUrange: 10.0
      maxRange: 10.1
      particles: 100

      linearUpdate: 0.3
      angularUpdate: 0.5
      temporalUpdate: 2.0
      resampleThreshold: 0.5

      xmin: -100.0
      ymin: -100.0
      xmax: 100.0
      ymax: 100.0
      delta: 0.05

      sigma: 0.05
      kernelSize: 1
      lstep: 0.05
      astep: 0.05
      iterations: 5
      lsigma: 0.075
      ogain: 3.0
      lskip: 0
      llsamplerange: 0.01
      llsamplestep: 0.01
      lasamplerange: 0.005
      lasamplestep: 0.005
    </rosparam>
  </node>

  <node if="$(arg show_rviz)"
        name="rviz1"
        pkg="rviz"
        type="rviz"
        args="-d $(find agilexpro)/rviz/mapping.rviz" />
</launch>
