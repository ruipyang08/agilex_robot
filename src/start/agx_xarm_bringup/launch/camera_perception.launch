<?xml version="1.0"?>
<launch>
  <!-- This launch owns perception only. The selected runtime must provide
       hardware-compatible Image, CameraInfo, and canonical camera TF data. -->
  <arg name="camera_namespace" default="cam1" />
  <arg name="image_topic" default="/cam1/color/image_raw" />
  <arg name="camera_info_topic" default="/cam1/color/camera_info" />
  <arg name="output_frame" default="link_base" />
  <arg name="marker_size_cm" default="3" />
  <!-- Marker pose is on the object's visible face. Advance the fingers far
       enough for pad overlap without driving the wrist into the object.
       Override this calibration for targets with a different grasp depth. -->
  <arg name="front_grasp_insertion_m" default="0.015" />
  <!-- The hardware default rejects observations older than one wall-clock
       second. Slower simulation render/ALVAR pipelines may override this
       without changing the marker listener implementation. -->
  <arg name="marker_freshness_timeout_sec" default="1.0" />
  <param name="marker_freshness_timeout_sec" value="$(arg marker_freshness_timeout_sec)" />
  <param name="front_grasp_insertion_m" value="$(arg front_grasp_insertion_m)" />

  <include file="$(find ar_track_alvar)/launch/pr2_indiv_no_kinect.launch">
    <arg name="marker_size" value="$(arg marker_size_cm)" />
    <arg name="max_new_marker_error" value="0.08" />
    <arg name="max_track_error" value="0.2" />
    <arg name="cam_image_topic" value="$(arg image_topic)" />
    <arg name="cam_info_topic" value="$(arg camera_info_topic)" />
    <arg name="output_frame" value="$(arg output_frame)" />
    <arg name="node_name" value="$(arg camera_namespace)" />
  </include>

  <node pkg="mark_listenner"
        type="mark_listenner"
        name="mark_listenner"
        output="screen" />
</launch>
