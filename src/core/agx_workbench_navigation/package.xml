<?xml version="1.0"?>
<package format="2">
  <name>agx_workbench_navigation</name>
  <version>0.1.0</version>
  <description>Deployable ROS1 interfaces and configuration for workbench navigation.</description>
  <maintainer email="devnull@example.com">ranger_arm maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>

  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>
  <depend>angles</depend>
  <depend>ar_track_alvar</depend>
  <depend>ar_track_alvar_msgs</depend>
  <exec_depend>base_local_planner</exec_depend>
  <depend>costmap_2d</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>move_base_msgs</depend>
  <depend>nav_core</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>yaml-cpp</depend>
  <depend>libssl-dev</depend>

  <exec_depend>message_runtime</exec_depend>
  <exec_depend>agilexpro</exec_depend>
  <exec_depend>agx_bringup</exec_depend>
  <exec_depend>agx_xarm_bringup</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>rostest</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>move_base</test_depend>
  <export>
    <nav_core plugin="${prefix}/ranger_local_planner_plugin.xml"/>
  </export>
</package>
